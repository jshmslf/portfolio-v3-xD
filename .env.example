# portfolio-v3 environment variables. Copy to .env.local and fill in.
# See README.md for details. Never commit real values.

# --- Database (Supabase) — same project as portfolio-cms -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for writes (leads, testimonials, likes) — keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Canonical origin, no trailing slash (e.g. https://example.com).
NEXT_PUBLIC_SITE_URL=

# --- Instant updates from the admin ----------------------------------------
# Shared with portfolio-cms: CMS -> site instant updates (POST /api/revalidate).
# Must be identical in both apps.
REVALIDATE_SECRET=

# --- Email (Resend) — Hire Me notification + auto-reply --------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Blog likes ------------------------------------------------------------
# Random string mixed into visitor IP hashes.
LIKE_IP_SALT=

# --- Extras (optional) -----------------------------------------------------
# GitHub contribution activity.
GITHUB_USERNAME=
GITHUB_TOKEN=
# Mapbox public token for the location map.
NEXT_PUBLIC_MAPBOX_TOKEN=
